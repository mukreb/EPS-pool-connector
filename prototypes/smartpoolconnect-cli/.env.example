# Copy to .env in this directory, or use a .env in the repository root.
# Never commit the real values.

# Preferred for a stable integration (request from SmartPoolConnect support).
# SPC_API_KEY=spc_your_key_here

# Alternative: the complete value of the connect_session browser cookie.
# This expires and must then be replaced.
# SPC_SESSION_COOKIE=paste_complete_cookie_here

# Optional alternatives and identifiers.
# SPC_ACCESS_TOKEN=paste_access_token_here
# SPC_POOL_ID=123e4567-e89b-12d3-a456-426614174000
# SPC_MAC=00:14:2D:AA:BB:CC
