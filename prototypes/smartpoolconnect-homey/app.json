{
  "id": "com.mukreb.smartpoolconnect",
  "version": "0.2.0",
  "compatibility": ">=10.0.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "Smart Pool Connect",
    "nl": "Smart Pool Connect"
  },
  "description": {
    "en": "Read live status from your SmartPoolConnect pool and control the deck cover, lighting and filter pump (water and ambient temperature, pH, redox/chlorine, filter, dry-run and fault alarms, deck cover, lighting).",
    "nl": "Lees live status van je SmartPoolConnect zwembad en bedien de afdekking, verlichting en filterpomp (water- en luchttemperatuur, pH, redox/chloor, filter, droogloop- en storingsalarm, afdekking, verlichting)."
  },
  "category": ["climate"],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "mukreb"
  },
  "brandColor": "#0099CC",
  "source": "https://github.com/mukreb/eps-pool-connector",
  "bugs": {
    "url": "https://github.com/mukreb/eps-pool-connector/issues"
  },
  "capabilities": {
    "measure_ph": {
      "type": "number",
      "title": { "en": "pH", "nl": "pH" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 2
    },
    "measure_redox": {
      "type": "number",
      "title": { "en": "Redox", "nl": "Redox" },
      "units": { "en": "mV", "nl": "mV" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 0
    },
    "measure_chlorine": {
      "type": "number",
      "title": { "en": "Free chlorine", "nl": "Vrij chloor" },
      "units": { "en": "ppm", "nl": "ppm" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 1
    },
    "measure_water_level": {
      "type": "number",
      "title": { "en": "Water level", "nl": "Waterniveau" },
      "units": { "en": "cm", "nl": "cm" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 1
    },
    "filter_running": {
      "type": "boolean",
      "title": { "en": "Filter pump", "nl": "Filterpomp" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insightsTitleTrue": { "en": "Running", "nl": "Draait" },
      "insightsTitleFalse": { "en": "Stopped", "nl": "Gestopt" }
    },
    "filter_status": {
      "type": "enum",
      "title": { "en": "Pump status", "nl": "Pompstatus" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        { "id": "off_disabled", "title": { "en": "Disabled", "nl": "Uitgeschakeld" } },
        { "id": "off", "title": { "en": "Off", "nl": "Uit" } },
        { "id": "schedule_1", "title": { "en": "Schedule 1", "nl": "Schema 1" } },
        { "id": "schedule_2", "title": { "en": "Schedule 2", "nl": "Schema 2" } },
        { "id": "schedule_3", "title": { "en": "Schedule 3", "nl": "Schema 3" } },
        { "id": "heating", "title": { "en": "Heating", "nl": "Verwarming" } },
        { "id": "solar", "title": { "en": "Solar", "nl": "Zonnecollector" } },
        { "id": "backwash", "title": { "en": "Backwash", "nl": "Backwash" } },
        { "id": "cooling", "title": { "en": "Cooling", "nl": "Koeling" } },
        { "id": "manual", "title": { "en": "Manual", "nl": "Handmatig" } },
        { "id": "frost_protection", "title": { "en": "Frost protection", "nl": "Vorstbeveiliging" } },
        { "id": "active", "title": { "en": "Active", "nl": "Actief" } },
        { "id": "cover", "title": { "en": "Deck cover", "nl": "Afdekking" } },
        { "id": "valve_fault", "title": { "en": "Valve fault", "nl": "Klepfout" } },
        { "id": "cover_low", "title": { "en": "Deck cover (low, normal)", "nl": "Afdekking laag (normaal)" } },
        { "id": "too_hot", "title": { "en": "Too hot", "nl": "Te warm" } },
        { "id": "invalid", "title": { "en": "Invalid", "nl": "Ongeldig" } },
        { "id": "unknown", "title": { "en": "Unknown", "nl": "Onbekend" } }
      ]
    },
    "filter_speed": {
      "type": "enum",
      "title": { "en": "Filter speed", "nl": "Filtersnelheid" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        { "id": "off", "title": { "en": "Off", "nl": "Uit" } },
        { "id": "low", "title": { "en": "Low", "nl": "Laag" } },
        { "id": "medium", "title": { "en": "Medium", "nl": "Midden" } },
        { "id": "high", "title": { "en": "High", "nl": "Hoog" } },
        { "id": "max", "title": { "en": "Max", "nl": "Max" } }
      ]
    },
    "alarm_dryrun": {
      "type": "boolean",
      "title": { "en": "Dry-run risk", "nl": "Droogloop-risico" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insightsTitleTrue": { "en": "Risk detected", "nl": "Risico gedetecteerd" },
      "insightsTitleFalse": { "en": "No risk", "nl": "Geen risico" }
    },
    "alarm_fault": {
      "type": "boolean",
      "title": { "en": "Fault", "nl": "Storing" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insightsTitleTrue": { "en": "Fault", "nl": "Storing" },
      "insightsTitleFalse": { "en": "OK", "nl": "OK" }
    },
    "alarm_water_level": {
      "type": "boolean",
      "title": { "en": "Water level deviation", "nl": "Waterniveau-afwijking" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insightsTitleTrue": { "en": "Deviating", "nl": "Wijkt af" },
      "insightsTitleFalse": { "en": "Normal", "nl": "Normaal" }
    },
    "cover_state": {
      "type": "enum",
      "title": { "en": "Deck cover position", "nl": "Stand afdekking" },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "values": [
        { "id": "open", "title": { "en": "Open", "nl": "Open" } },
        { "id": "closed", "title": { "en": "Closed", "nl": "Dicht" } },
        { "id": "opening", "title": { "en": "Opening", "nl": "Gaat open" } },
        { "id": "closing", "title": { "en": "Closing", "nl": "Gaat dicht" } },
        { "id": "stopped", "title": { "en": "Stopped halfway", "nl": "Gestopt halverwege" } },
        { "id": "unknown", "title": { "en": "Unknown", "nl": "Onbekend" } }
      ]
    }
  },
  "drivers": [
    {
      "id": "pool",
      "name": { "en": "Pool", "nl": "Zwembad" },
      "class": "sensor",
      "capabilities": [
        "measure_temperature",
        "measure_temperature.ambient",
        "measure_ph",
        "measure_redox",
        "measure_chlorine",
        "measure_water_level",
        "measure_current",
        "filter_running",
        "filter_status",
        "filter_speed",
        "alarm_dryrun",
        "alarm_fault",
        "alarm_water_level"
      ],
      "capabilitiesOptions": {
        "measure_temperature": {
          "title": { "en": "Water temperature", "nl": "Watertemperatuur" }
        },
        "measure_temperature.ambient": {
          "title": { "en": "Ambient temperature", "nl": "Luchttemperatuur" }
        },
        "measure_current": {
          "title": { "en": "Pump current", "nl": "Pompstroom" }
        }
      },
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/pool/assets/images/small.png",
        "large": "/drivers/pool/assets/images/large.png",
        "xlarge": "/drivers/pool/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "enter_credentials",
          "navigation": { "next": "list_pools" }
        },
        {
          "id": "list_pools",
          "template": "list_devices",
          "navigation": { "prev": "enter_credentials", "next": "add_devices" }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair_credentials"
        }
      ],
      "settings": [
        {
          "id": "poll_interval",
          "type": "number",
          "label": { "en": "Poll interval (seconds)", "nl": "Polling interval (seconden)" },
          "value": 30,
          "min": 15,
          "max": 300,
          "hint": {
            "en": "How often to fetch the pool status. The API allows ~60 requests/minute per key.",
            "nl": "Hoe vaak de zwembadstatus opgehaald wordt. De API staat ~60 verzoeken/minuut per key toe."
          }
        }
      ]
    },
    {
      "id": "cover",
      "name": { "en": "Deck cover", "nl": "Afdekking" },
      "class": "windowcoverings",
      "capabilities": ["windowcoverings_state", "cover_state"],
      "capabilitiesOptions": {
        "cover_state": {
          "title": { "en": "Position", "nl": "Stand" }
        }
      },
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/cover/assets/images/small.png",
        "large": "/drivers/cover/assets/images/large.png",
        "xlarge": "/drivers/cover/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_pools",
          "template": "list_devices",
          "navigation": { "next": "add_devices" }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair_credentials"
        }
      ],
      "settings": [
        {
          "id": "allow_control",
          "type": "checkbox",
          "label": { "en": "Allow cover control", "nl": "Bediening afdekking toestaan" },
          "value": false,
          "hint": {
            "en": "Moving the cover is a physical action that can trap someone in the water, and the stop command also runs through the cloud — it is not a local emergency stop. While this is off, the cover is read-only and the flow actions are blocked. Keep local/manual control reachable at all times.",
            "nl": "De afdekking bewegen is een fysieke handeling die iemand in het water kan beknellen, en ook het stopcommando loopt via de cloud — het is geen lokale noodstop. Zolang dit uit staat is de afdekking alleen-lezen en zijn de flow-acties geblokkeerd. Houd de lokale/handmatige bediening altijd bereikbaar."
          }
        }
      ]
    },
    {
      "id": "light",
      "name": { "en": "Pool lighting", "nl": "Zwembadverlichting" },
      "class": "light",
      "capabilities": ["onoff", "button.next_colour", "button.reset_colour"],
      "capabilitiesOptions": {
        "button.next_colour": {
          "title": { "en": "Next colour", "nl": "Volgende kleur" }
        },
        "button.reset_colour": {
          "title": { "en": "Reset colour", "nl": "Kleur resetten" }
        }
      },
      "platforms": ["local"],
      "connectivity": ["cloud"],
      "images": {
        "small": "/drivers/light/assets/images/small.png",
        "large": "/drivers/light/assets/images/large.png",
        "xlarge": "/drivers/light/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_pools",
          "template": "list_devices",
          "navigation": { "next": "add_devices" }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair_credentials"
        }
      ]
    }
  ]
}
