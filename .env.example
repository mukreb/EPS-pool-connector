# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# Secret API key (request one via support@epsbv.eu).
EPS_API_KEY=your-api-key-here

# Pool serial number in MAC-address notation.
EPS_SERIAL=00:14:2D:A8:B1:42

# Optional: override the API base URL (defaults to the public one below).
# EPS_BASE_URL=https://api.Smartpoolcontrol.eu/publicapi/
